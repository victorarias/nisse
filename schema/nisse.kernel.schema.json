{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nisse kernel protocol",
  "protocol": 1,
  "methods": {
    "initialize": {
      "params": {
        "type": "object",
        "properties": {
          "client": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "protocol": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "client",
          "version",
          "protocol"
        ],
        "additionalProperties": true
      },
      "result": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "protocol": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "version",
          "protocol"
        ],
        "additionalProperties": true
      },
      "error": {
        "not": {}
      },
      "stream": false
    },
    "conversation/start": {
      "params": {
        "type": "object",
        "properties": {
          "cwd": {
            "type": "string",
            "description": "The directory the conversation works in."
          },
          "id": {
            "type": "string",
            "description": "The id to name it by, chosen by the client; not all digits. Starting again with an id that names a conversation answers with that one and changes nothing."
          },
          "approvals": {
            "type": "string",
            "enum": [
              "ask",
              "auto"
            ],
            "description": "Default ask."
          },
          "provider": {
            "type": "string",
            "description": "Absent for the default: the project's default_model, the home's, the model chosen last, else the preferred provider."
          },
          "model": {
            "type": "string",
            "description": "Without a provider, it goes to the default model's provider."
          },
          "effort": {
            "type": "string"
          },
          "instructions": {
            "type": "string",
            "description": "Instructions the model follows in this conversation, beside its own. Its subagents don't get them."
          }
        },
        "required": [
          "cwd"
        ],
        "additionalProperties": true
      },
      "result": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "string",
            "description": "A conversation's id: the one its client chose at conversation/start, or else the number it gave."
          },
          "model": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string"
              },
              "model": {
                "type": "string",
                "description": "Absent for the provider's own choice, as Claude Code makes it."
              },
              "effort": {
                "type": "string",
                "description": "Absent for the model's own default."
              }
            },
            "required": [
              "provider"
            ],
            "additionalProperties": true,
            "description": "The model it runs, defaults applied, with the provider's default model when none was named; for an id that names one, that conversation's."
          }
        },
        "required": [
          "conversation",
          "model"
        ],
        "additionalProperties": true
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/InvalidConversationIdEncoded"
          },
          {
            "$ref": "#/$defs/UnknownProviderEncoded"
          },
          {
            "$ref": "#/$defs/UnknownEffortEncoded"
          }
        ]
      },
      "stream": false
    },
    "conversation/submit": {
      "params": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "string",
            "description": "A conversation's id: the one its client chose at conversation/start, or else the number it gave."
          },
          "requestId": {
            "type": "string",
            "description": "Submitting again with the same id is answered once."
          },
          "author": {
            "type": "string",
            "description": "Who wrote it; the input is placed as a nisse.user entry naming them, and waits in pi.inbox with them."
          },
          "text": {
            "type": "string"
          },
          "steer": {
            "type": "boolean",
            "description": "Reach the run in flight at its next step instead of waiting for it to end; idle, it starts a run."
          }
        },
        "required": [
          "conversation",
          "requestId",
          "author",
          "text"
        ],
        "additionalProperties": true
      },
      "result": {
        "type": "object",
        "properties": {
          "submission": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "submission"
        ],
        "additionalProperties": true
      },
      "error": {
        "$ref": "#/$defs/NoSuchConversationEncoded"
      },
      "stream": false
    },
    "conversation/watch": {
      "params": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "string",
            "description": "A conversation's id: the one its client chose at conversation/start, or else the number it gave."
          },
          "window": {
            "type": "object",
            "properties": {
              "from": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "Start the window at this entry, such as the one after the last you hold."
              },
              "min": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "The newest entries the window holds at least; 50."
              },
              "max": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "Past this many, the oldest leave the window down to min; twice min."
              }
            },
            "additionalProperties": true
          }
        },
        "required": [
          "conversation"
        ],
        "additionalProperties": true
      },
      "result": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "_tag": {
                "type": "string",
                "enum": [
                  "view"
                ]
              },
              "view": {
                "type": "object",
                "properties": {
                  "conversation": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "parent": {
                        "type": "object",
                        "properties": {
                          "conversationId": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "at": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "conversationId",
                          "at"
                        ],
                        "additionalProperties": true,
                        "description": "The conversation this one was forked from, and the last entry it inherits."
                      },
                      "owner": {
                        "type": "object",
                        "properties": {
                          "conversationId": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "taskId": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "conversationId",
                          "taskId"
                        ],
                        "additionalProperties": true,
                        "description": "The task that created this conversation, and that task's conversation."
                      }
                    },
                    "required": [
                      "id"
                    ],
                    "additionalProperties": true
                  },
                  "entries": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "conversationId": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "kind": {
                          "type": "string",
                          "description": "pi.user, pi.assistant and pi.tool-result carry model messages in `model`; nisse.run_end says how a run ended in `data`, nisse.approval who answered a call."
                        },
                        "model": {
                          "type": "array"
                        },
                        "data": {},
                        "head": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "edits": {
                          "type": "array"
                        },
                        "byTaskId": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "id",
                        "conversationId",
                        "kind"
                      ],
                      "additionalProperties": true,
                      "description": "One immutable transcript record."
                    },
                    "description": "A window over the transcript, oldest first."
                  },
                  "before": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991,
                    "description": "The entry just before the window; absent when the window starts the transcript."
                  },
                  "docs": {
                    "type": "object",
                    "description": "pi.agent, pi.live, pi.inbox, pi.provider, pi.usage and nisse.approvals, by kind; pi.live holds the run in flight, nisse.approvals the calls waiting for a person."
                  }
                },
                "required": [
                  "conversation",
                  "entries",
                  "docs"
                ],
                "additionalProperties": true
              }
            },
            "required": [
              "_tag",
              "view"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "_tag": {
                "type": "string",
                "enum": [
                  "change"
                ]
              },
              "ops": {
                "type": "array",
                "description": "The operations one commit applied to the view, in order: [\"r\", value] replaces it, [\"s\", path, value] sets, [\"d\", path] deletes, [\"a\", path, text] appends text, [\"t\", path, length] truncates text, [\"p\", path, at, deleteCount, items] splices an array, [\"m\", path, permutation] reorders one."
              }
            },
            "required": [
              "_tag",
              "ops"
            ],
            "additionalProperties": true
          }
        ],
        "description": "The view through the window, then each commit's changes to it."
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/NoSuchConversationEncoded"
          },
          {
            "$ref": "#/$defs/InvalidWindowEncoded"
          },
          {
            "$ref": "#/$defs/FellBehindEncoded"
          }
        ]
      },
      "stream": true
    },
    "conversation/interrupt": {
      "params": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "string",
            "description": "Stops its run; what was said stays."
          }
        },
        "required": [
          "conversation"
        ],
        "additionalProperties": true
      },
      "result": {
        "type": "null"
      },
      "error": {
        "$ref": "#/$defs/NoSuchConversationEncoded"
      },
      "stream": false
    },
    "approval/resolve": {
      "params": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "string",
            "description": "A conversation's id: the one its client chose at conversation/start, or else the number it gave."
          },
          "approval": {
            "type": "string",
            "description": "A key of the view's nisse.approvals `requests`: the call's tool task."
          },
          "author": {
            "type": "string",
            "description": "Who answers; the transcript names them."
          },
          "allow": {
            "type": "boolean"
          }
        },
        "required": [
          "conversation",
          "approval",
          "author",
          "allow"
        ],
        "additionalProperties": true
      },
      "result": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean",
            "description": "False when another answer came first, or the call is no longer waiting: the first answer counts."
          }
        },
        "required": [
          "accepted"
        ],
        "additionalProperties": true
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/NoSuchConversationEncoded"
          },
          {
            "$ref": "#/$defs/NoSuchApprovalEncoded"
          }
        ]
      },
      "stream": false
    },
    "extensions/list": {
      "params": {
        "type": "null"
      },
      "result": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "loaded",
                "failed",
                "disabled"
              ]
            },
            "message": {
              "type": "string",
              "description": "Why it failed to load."
            }
          },
          "required": [
            "name",
            "path",
            "state"
          ],
          "additionalProperties": true
        },
        "description": "Every extension in the home, in the order they load."
      },
      "error": {
        "not": {}
      },
      "stream": false
    },
    "extensions/reload": {
      "params": {
        "type": "null"
      },
      "result": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "loaded",
                "failed",
                "disabled"
              ]
            },
            "message": {
              "type": "string",
              "description": "Why it failed to load."
            }
          },
          "required": [
            "name",
            "path",
            "state"
          ],
          "additionalProperties": true
        },
        "description": "Loads every extension again from disk, with its options from config.toml, then swaps them in, clears every status line and unloads the old ones."
      },
      "error": {
        "not": {}
      },
      "stream": false
    },
    "status/watch": {
      "params": {
        "type": "null"
      },
      "result": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "_tag": {
                "type": "string",
                "enum": [
                  "trees"
                ]
              },
              "seq": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "The last commit this server published before the watch began; 0 when it has published none since it started. Every later item has a greater seq."
              },
              "trees": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "_tag": {
                      "type": "string",
                      "enum": [
                        "tree"
                      ]
                    },
                    "conversation": {
                      "type": "string",
                      "description": "A conversation people started; its tree is it and its subagents."
                    },
                    "seq": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991,
                      "description": "The commit the tree's status changed at; 0 for a tree that was already busy when the server started, before any change."
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "idle",
                        "working",
                        "waiting"
                      ],
                      "description": "waiting when a conversation in the tree waits on a person, working when one runs, idle otherwise."
                    },
                    "ended": {
                      "type": "object",
                      "properties": {
                        "outcome": {
                          "type": "string",
                          "enum": [
                            "answered",
                            "interrupted",
                            "failed",
                            "restart_limit"
                          ]
                        },
                        "message": {
                          "type": "string",
                          "description": "Why the run ended without an answer."
                        },
                        "said": {
                          "type": "string",
                          "description": "The last message the model wrote in the conversation."
                        }
                      },
                      "required": [
                        "outcome"
                      ],
                      "additionalProperties": true,
                      "description": "The run of the conversation itself ended at seq."
                    }
                  },
                  "required": [
                    "_tag",
                    "conversation",
                    "seq",
                    "status"
                  ],
                  "additionalProperties": true
                },
                "description": "Every tree that is not idle; the rest are idle."
              }
            },
            "required": [
              "_tag",
              "seq",
              "trees"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "_tag": {
                "type": "string",
                "enum": [
                  "tree"
                ]
              },
              "conversation": {
                "type": "string",
                "description": "A conversation people started; its tree is it and its subagents."
              },
              "seq": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "The commit the tree's status changed at; 0 for a tree that was already busy when the server started, before any change."
              },
              "status": {
                "type": "string",
                "enum": [
                  "idle",
                  "working",
                  "waiting"
                ],
                "description": "waiting when a conversation in the tree waits on a person, working when one runs, idle otherwise."
              },
              "ended": {
                "type": "object",
                "properties": {
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "answered",
                      "interrupted",
                      "failed",
                      "restart_limit"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "description": "Why the run ended without an answer."
                  },
                  "said": {
                    "type": "string",
                    "description": "The last message the model wrote in the conversation."
                  }
                },
                "required": [
                  "outcome"
                ],
                "additionalProperties": true,
                "description": "The run of the conversation itself ended at seq."
              }
            },
            "required": [
              "_tag",
              "conversation",
              "seq",
              "status"
            ],
            "additionalProperties": true
          }
        ],
        "description": "The status of every tree, then each commit that changes one or ends the run of its root."
      },
      "error": {
        "$ref": "#/$defs/FellBehindEncoded"
      },
      "stream": true
    },
    "server/stop": {
      "params": {
        "type": "null"
      },
      "result": {
        "type": "null"
      },
      "error": {
        "not": {}
      },
      "stream": false
    },
    "providers/list": {
      "params": {
        "type": "object",
        "properties": {
          "refresh": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      },
      "result": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "driver": {
              "type": "string",
              "description": "Its kind: claude, openai or script."
            },
            "signIn": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "browser",
                  "device_code",
                  "terminal"
                ],
                "description": "browser: a browser on the server's machine signs in and calls back to it. device_code: any device signs in with a short code. terminal: the provider's own sign-in command runs in a terminal on the server's machine."
              },
              "description": "The ways to sign in, the first one preferred."
            },
            "health": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "ready",
                    "signed_out",
                    "unavailable"
                  ]
                },
                "version": {
                  "type": "string"
                },
                "account": {
                  "type": "string",
                  "description": "Who it is signed in as, and on what plan."
                },
                "message": {
                  "type": "string",
                  "description": "Why it is not ready, or what to do about it."
                },
                "checkedAt": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "status",
                "checkedAt"
              ],
              "additionalProperties": true
            }
          },
          "required": [
            "id",
            "driver",
            "signIn",
            "health"
          ],
          "additionalProperties": true
        }
      },
      "error": {
        "not": {}
      },
      "stream": false
    },
    "models/list": {
      "params": {
        "type": "object",
        "properties": {
          "refresh": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      },
      "result": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "defaultModel": {
              "type": "string",
              "description": "What a selection naming no model gets; absent when the provider picks."
            },
            "models": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "efforts": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "The reasoning efforts it takes, least first."
                  },
                  "defaultEffort": {
                    "type": "string"
                  },
                  "contextWindow": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "id",
                  "name",
                  "efforts"
                ],
                "additionalProperties": true
              },
              "description": "Best first."
            }
          },
          "required": [
            "provider",
            "models"
          ],
          "additionalProperties": true
        }
      },
      "error": {
        "not": {}
      },
      "stream": false
    },
    "auth/start": {
      "params": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "enum": [
              "browser",
              "device_code",
              "terminal"
            ],
            "description": "browser: a browser on the server's machine signs in and calls back to it. device_code: any device signs in with a short code. terminal: the provider's own sign-in command runs in a terminal on the server's machine."
          }
        },
        "required": [
          "provider"
        ],
        "additionalProperties": true
      },
      "result": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "flow": {
            "type": "string"
          },
          "phase": {
            "type": "string",
            "enum": [
              "starting",
              "waiting",
              "verifying",
              "succeeded",
              "failed",
              "cancelled",
              "signed_out"
            ]
          },
          "interaction": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "_tag": {
                    "type": "string",
                    "enum": [
                      "browser"
                    ]
                  },
                  "url": {
                    "type": "string"
                  }
                },
                "required": [
                  "_tag",
                  "url"
                ],
                "additionalProperties": true,
                "description": "Open url and sign in. A browser on another machine can't call back: answer with the address it ends on."
              },
              {
                "type": "object",
                "properties": {
                  "_tag": {
                    "type": "string",
                    "enum": [
                      "device_code"
                    ]
                  },
                  "url": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                },
                "required": [
                  "_tag",
                  "url",
                  "code"
                ],
                "additionalProperties": true
              },
              {
                "type": "object",
                "properties": {
                  "_tag": {
                    "type": "string",
                    "enum": [
