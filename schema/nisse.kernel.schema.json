{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nisse kernel protocol",
  "protocol": 1,
  "methods": {
    "initialize": {
      "params": {
        "type": "object",
        "properties": {
          "client": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "protocol": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "client",
          "version",
          "protocol"
        ],
        "additionalProperties": true
      },
      "result": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "protocol": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "version",
          "protocol"
        ],
        "additionalProperties": true
      },
      "error": {
        "not": {}
      },
      "stream": false
    },
    "conversation/start": {
      "params": {
        "type": "object",
        "properties": {
          "cwd": {
            "type": "string",
            "description": "The directory the conversation works in."
          },
          "id": {
            "type": "string",
            "description": "The id to name it by, chosen by the client; not all digits. Starting again with an id that names a conversation answers with that one and changes nothing."
          },
          "approvals": {
            "type": "string",
            "enum": [
              "ask",
              "auto"
            ],
            "description": "Default ask."
          }
        },
        "required": [
          "cwd"
        ],
        "additionalProperties": true
      },
      "result": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "string",
            "description": "A conversation's id: the one its client chose at conversation/start, or else the number it gave."
          }
        },
        "required": [
          "conversation"
        ],
        "additionalProperties": true
      },
      "error": {
        "$ref": "#/$defs/InvalidConversationIdEncoded"
      },
      "stream": false
    },
    "conversation/submit": {
      "params": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "string",
            "description": "A conversation's id: the one its client chose at conversation/start, or else the number it gave."
          },
          "requestId": {
            "type": "string",
            "description": "Submitting again with the same id is answered once."
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "conversation",
          "requestId",
          "text"
        ],
        "additionalProperties": true
      },
      "result": {
        "type": "object",
        "properties": {
          "submission": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "submission"
        ],
        "additionalProperties": true
      },
      "error": {
        "$ref": "#/$defs/NoSuchConversationEncoded"
      },
      "stream": false
    },
    "conversation/watch": {
      "params": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "string",
            "description": "A conversation's id: the one its client chose at conversation/start, or else the number it gave."
          },
          "window": {
            "type": "object",
            "properties": {
              "from": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "Start the window at this entry, such as the one after the last you hold."
              },
              "min": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "The newest entries the window holds at least; 50."
              },
              "max": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "Past this many, the oldest leave the window down to min; twice min."
              }
            },
            "additionalProperties": true
          }
        },
        "required": [
          "conversation"
        ],
        "additionalProperties": true
      },
      "result": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "_tag": {
                "type": "string",
                "enum": [
                  "view"
                ]
              },
              "view": {
                "type": "object",
                "properties": {
                  "conversation": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "parent": {
                        "type": "object",
                        "properties": {
                          "conversationId": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "at": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "conversationId",
                          "at"
                        ],
                        "additionalProperties": true,
                        "description": "The conversation this one was forked from, and the last entry it inherits."
                      },
                      "owner": {
                        "type": "object",
                        "properties": {
                          "conversationId": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "taskId": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "conversationId",
                          "taskId"
                        ],
                        "additionalProperties": true,
                        "description": "The task that created this conversation, and that task's conversation."
                      }
                    },
                    "required": [
                      "id"
                    ],
                    "additionalProperties": true
                  },
                  "entries": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "conversationId": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "kind": {
                          "type": "string",
                          "description": "pi.user, pi.assistant and pi.tool-result carry model messages in `model`; nisse.run_end says how a run ended in `data`, nisse.approval who answered a call."
                        },
                        "model": {
                          "type": "array"
                        },
                        "data": {},
                        "head": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "edits": {
                          "type": "array"
                        },
                        "byTaskId": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "id",
                        "conversationId",
                        "kind"
                      ],
                      "additionalProperties": true,
                      "description": "One immutable transcript record."
                    },
                    "description": "A window over the transcript, oldest first."
                  },
                  "before": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991,
                    "description": "The entry just before the window; absent when the window starts the transcript."
                  },
                  "docs": {
                    "type": "object",
                    "description": "pi.agent, pi.live, pi.inbox, pi.provider, pi.usage and nisse.approvals, by kind; pi.live holds the run in flight, nisse.approvals the calls waiting for a person."
                  }
                },
                "required": [
                  "conversation",
                  "entries",
                  "docs"
                ],
                "additionalProperties": true
              }
            },
            "required": [
              "_tag",
              "view"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "_tag": {
                "type": "string",
                "enum": [
                  "change"
                ]
              },
              "ops": {
                "type": "array",
                "description": "The operations one commit applied to the view, in order: [\"r\", value] replaces it, [\"s\", path, value] sets, [\"d\", path] deletes, [\"a\", path, text] appends text, [\"t\", path, length] truncates text, [\"p\", path, at, deleteCount, items] splices an array, [\"m\", path, permutation] reorders one."
              }
            },
            "required": [
              "_tag",
              "ops"
            ],
            "additionalProperties": true
          }
        ],
        "description": "The view through the window, then each commit's changes to it."
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/NoSuchConversationEncoded"
          },
          {
            "$ref": "#/$defs/InvalidWindowEncoded"
          },
          {
            "$ref": "#/$defs/FellBehindEncoded"
          }
        ]
      },
      "stream": true
    },
    "conversation/interrupt": {
      "params": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "string",
            "description": "Stops its run; what was said stays."
          }
        },
        "required": [
          "conversation"
        ],
        "additionalProperties": true
      },
      "result": {
        "type": "null"
      },
      "error": {
        "$ref": "#/$defs/NoSuchConversationEncoded"
      },
      "stream": false
    },
    "approval/resolve": {
      "params": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "string",
            "description": "A conversation's id: the one its client chose at conversation/start, or else the number it gave."
          },
          "approval": {
            "type": "string",
            "description": "A key of the view's nisse.approvals `requests`: the call's tool task."
          },
          "author": {
            "type": "string",
            "description": "Who answers; the transcript names them."
          },
          "allow": {
            "type": "boolean"
          }
        },
        "required": [
          "conversation",
          "approval",
          "author",
          "allow"
        ],
        "additionalProperties": true
      },
      "result": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean",
            "description": "False when another answer came first, or the call is no longer waiting: the first answer counts."
          }
        },
        "required": [
          "accepted"
        ],
        "additionalProperties": true
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/NoSuchConversationEncoded"
          },
          {
            "$ref": "#/$defs/NoSuchApprovalEncoded"
          }
        ]
      },
      "stream": false
    },
    "server/stop": {
      "params": {
        "type": "null"
      },
      "result": {
        "type": "null"
      },
      "error": {
        "not": {}
      },
      "stream": false
    }
  },
  "$defs": {
    "InvalidConversationIdEncoded": {
      "type": "object",
      "properties": {
        "_tag": {
          "type": "string",
          "enum": [
            "InvalidConversationId"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "_tag",
        "message"
      ],
      "additionalProperties": true
    },
    "NoSuchConversationEncoded": {
      "type": "object",
      "properties": {
        "_tag": {
          "type": "string",
          "enum": [
            "NoSuchConversation"
          ]
        },
        "conversation": {
          "type": "string"
        }
      },
      "required": [
        "_tag",
        "conversation"
      ],
      "additionalProperties": true
    },
    "InvalidWindowEncoded": {
      "type": "object",
      "properties": {
        "_tag": {
          "type": "string",
          "enum": [
            "InvalidWindow"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "_tag",
        "message"
      ],
      "additionalProperties": true
    },
    "FellBehindEncoded": {
      "type": "object",
      "properties": {
        "_tag": {
          "type": "string",
          "enum": [
            "FellBehind"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "The changes a watch may hold unread before it is dropped; watch again from the position you hold."
        }
      },
      "required": [
        "_tag",
        "limit"
      ],
      "additionalProperties": true
    },
    "NoSuchApprovalEncoded": {
      "type": "object",
      "properties": {
        "_tag": {
          "type": "string",
          "enum": [
            "NoSuchApproval"
          ]
        },
        "approval": {
          "type": "string"
        }
      },
      "required": [
        "_tag",
        "approval"
      ],
      "additionalProperties": true
    }
  }
}
