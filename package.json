{
  "name": "nisse-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "tsc --noEmit && prettier --check . && bun test",
    "format": "prettier --write .",
    "schema": "bun packages/nisse/src/main.ts schema > schema/nisse.schema.json"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@xterm/headless": "6.0.0",
    "prettier": "3.6.2",
    "typescript": "6.0.3"
  }
}
